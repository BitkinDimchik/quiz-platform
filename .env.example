PORT=3000
LISTEN_HOST=0.0.0.0
# Если QR для игроков подставляет «левый» IP (вирт. адаптер), задайте LAN-адрес вручную
# HOST_PUBLIC_IP=192.168.1.10
# Лимит тела HTTP (JSON и т.д.): конструктор шлёт data URL картинок — нужны десятки MB
HTTP_BODY_LIMIT=32mb
# automatic: автопереход к следующему вопросу по таймеру
AUTO_ADVANCE_TICK_MS=500
# После отключения WS ведущего: через N мс комната закрывается, игроки получают session_abandoned (мин. 5000)
HOST_SESSION_GRACE_MS=60000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Локальный файл БД (создаётся сам). Для тестов можно :memory:
DATABASE_PATH=data/quiz.sqlite
TYPEORM_LOGGING=false
# Пусто или * — телефоны в той же Wi‑Fi могут открывать страницу. Список через запятую — только эти origin.
CORS_ORIGINS=*
# API keys: session — join игроков
QUIZ_SESSION_API_KEY=change-me-session
# JWT: смените, если папку копируют на другой ПК не только вы
JWT_SECRET=change-me-jwt-secret-min-32-chars-recommended
# Срок access token в секундах (по умолчанию 7 суток)
JWT_EXPIRES_SEC=604800
# Throttler (опционально)
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
THROTTLE_JOIN_TTL_MS=60000
THROTTLE_JOIN_LIMIT=200
