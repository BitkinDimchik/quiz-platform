{
  "name": "quiz-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "bcrypt": true,
    "@nestjs/core": true
  },
  "scripts": {
    "prestart": "node scripts/ensure-native-modules.js",
    "prestart:dev": "node scripts/ensure-native-modules.js",
    "prestart:prod": "node scripts/ensure-native-modules.js",
    "ensure:native": "node scripts/ensure-native-modules.js",
    "build": "node scripts/run-vite.js build && nest build",
    "start": "nest start",
    "start:dev": "node -e \"try{require('fs').rmSync('dist/src',{recursive:true,force:true})}catch(e){} try{require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})}catch(e){}\" && nest build && concurrently -k \"nest start --watch\" \"node scripts/wait-for-port.js 3000 && node scripts/run-vite.js dev\"",
    "web:dev": "node scripts/run-vite.js dev",
    "start:prod": "node dist/main.js",
    "test": "jest --config ./test/jest-unit.json --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.15",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.20",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^10.0.5",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
